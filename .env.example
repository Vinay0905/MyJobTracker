# DevRadar Environment Configuration

# Database (Default: local SQLite database, seamlessly upgradeable to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./devradar.db

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Crawler & Sync Settings
MAX_CONCURRENT_HOST_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=15
SYNC_RETRY_ATTEMPTS=3
CONSECUTIVE_MISSING_SYNCS_FOR_CLOSURE=3

# Optional LLM Enrichment (Gemini API)
GEMINI_API_KEY=
LLM_ENRICHMENT_ENABLED=false
